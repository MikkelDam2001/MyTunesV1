<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="217.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sea.mytunesv1.GUI.NewPlaylistController">
   <children>
      <Label layoutX="14.0" layoutY="38.0" text="New playlist">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
      <Label layoutX="14.0" layoutY="102.0" text="Name">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <TextField fx:id="txtPlaylistName" layoutX="80.0" layoutY="98.0" prefHeight="26.0" prefWidth="304.0" promptText="Playlist name">
         <font>
            <Font size="15.0" />
         </font>
      </TextField>
      <Button fx:id="btnSavePlaylist" layoutX="341.0" layoutY="179.0" mnemonicParsing="false" onAction="#handleSavePlaylist" text="Save" />
      <Button fx:id="btnCancelPlaylist" layoutX="277.0" layoutY="179.0" mnemonicParsing="false" onAction="#handleCancelPlaylist" text="Cancel" />
   </children>
</AnchorPane>
