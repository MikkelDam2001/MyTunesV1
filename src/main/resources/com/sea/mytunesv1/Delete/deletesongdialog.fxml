            <Label fx:id="lblYesNo" layoutX="56.0" layoutY="31.0" text="Are you sure">
               <font>
                  <Font size="15.0" />
               </font>
            </Label>
            <Button fx:id="btnSongDeleteFinal" layoutX="42.0" layoutY="70.0" mnemonicParsing="false" onAction="#handleSongDeleteFinal" text="Delete" />
            <Button fx:id="btnSongCancelFinal" layoutX="105.0" layoutY="70.0" mnemonicParsing="false" onAction="#handleSongCancelFinal" text="Cancel" />
