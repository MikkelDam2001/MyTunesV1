<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<DialogPane prefHeight="257.0" prefWidth="369.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sea.mytunesv1.GUI.PlaylistController">
   <header>
      <AnchorPane prefHeight="259.0" prefWidth="369.0">
         <children>
            <Label fx:id="lblEditPlaylist" layoutX="13.0" layoutY="38.0" text="Edit playlist">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <TextField fx:id="txtNameOfNewPlaylist" layoutX="98.0" layoutY="104.0" prefHeight="26.0" prefWidth="247.0" />
            <Label fx:id="lblPlaylistName" layoutX="14.0" layoutY="109.0" text="Playlist name" />
            <Button fx:id="btnSavePlaylistEdit" layoutX="251.0" layoutY="138.0" mnemonicParsing="false" onAction="#handleSavePlaylistEdit" text="Save changes" />
            <Button fx:id="btnCancelPlaylistEdit" layoutX="185.0" layoutY="138.0" mnemonicParsing="false" onAction="#handleCancelPlaylistEdit" text="Cancel" />
         </children>
      </AnchorPane>
   </header>
</DialogPane>
