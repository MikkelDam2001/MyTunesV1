<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane prefHeight="310.0" prefWidth="419.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sea.mytunesv1.GUI.NewSongController">
   <children>
      <Label layoutX="10.0" layoutY="19.0" text="New song" />
      <Label layoutX="12.0" layoutY="62.0" text="Title" />
      <Label layoutX="12.0" layoutY="93.0" text="Artist" />
      <Label layoutX="12.0" layoutY="130.0" text="Category" />
      <Label layoutX="12.0" layoutY="168.0" text="Time" />
      <Label layoutX="12.0" layoutY="201.0" text="File" />
      <TextField fx:id="txtTitleOfSong" layoutX="94.0" layoutY="58.0" prefHeight="26.0" prefWidth="303.0" promptText="Song title" />
      <TextField fx:id="txtNameOfArtist" layoutX="95.0" layoutY="89.0" prefHeight="26.0" prefWidth="303.0" promptText="Artist name" />
      <TextField fx:id="txtTime" layoutX="95.0" layoutY="163.0" prefHeight="26.0" prefWidth="50.0" promptText="00:00" />
      <TextField fx:id="txtFilePath" layoutX="93.0" layoutY="197.0" prefHeight="26.0" prefWidth="230.0" promptText="song.mp3" />
      <Button fx:id="btnChooseFile" layoutX="339.0" layoutY="196.0" mnemonicParsing="false" onAction="#handleFileChosen" text="Choose" />
      <Button fx:id="btnCancel" layoutX="286.0" layoutY="273.0" mnemonicParsing="false" onAction="#handleCancelNewSong" text="Cancel" />
      <Button fx:id="btnSave" layoutX="355.0" layoutY="272.0" mnemonicParsing="false" onAction="#handleSaveNewSong" text="Save" />
      <ComboBox fx:id="cBoxGenre" layoutX="95.0" layoutY="126.0" onAction="#handleChooseGenre" prefHeight="26.0" prefWidth="305.0" promptText="Genre" />
   </children>
</AnchorPane>
